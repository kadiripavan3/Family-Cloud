<!-- NEVER RUN. Copied into the Android project by plugins/withJotAndroid.js; first built on a phone build made with JOT_NATIVE=1. See ../../../README.md. -->
<!-- The wide widget of design 14.1: "Jot" and the circle, the line that opens the jot bar with the mic, and four chips. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/jot_card">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/jot_name" android:textColor="@color/jot_text" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/jot_circle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/jot_muted" android:textSize="12sp" android:textStyle="bold" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/jot_field">
    <TextView android:id="@+id/jot_line" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:maxLines="1" android:ellipsize="end" android:text="@string/jot_line" android:textColor="@color/jot_muted" android:textSize="14sp" />
    <ImageView android:id="@+id/jot_mic" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="5dp" android:padding="9dp" android:background="@drawable/jot_tick_on" android:contentDescription="@string/jot_mic" android:src="@drawable/ic_jot_mic" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
    <TextView android:id="@+id/jot_chip_1" style="@style/JotChip" />
    <TextView android:id="@+id/jot_chip_2" style="@style/JotChip" />
    <TextView android:id="@+id/jot_chip_3" style="@style/JotChip" />
    <TextView android:id="@+id/jot_chip_4" style="@style/JotChip" />
  </LinearLayout>
</LinearLayout>
